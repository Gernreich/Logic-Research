   RowBox[{"MaxRecursion", "\[Rule]", "0"}], ",", 
   RowBox[{"PlotPoints", "\[Rule]", "150"}], ",", 
   RowBox[{"ContourStyle", "\[Rule]", 
    RowBox[{"Opacity", "[", "0.45", "]"}]}], ",", 
   RowBox[{"Contours", "\[Rule]", "5"}], ",", 
   RowBox[{"Mesh", "\[Rule]", "None"}], ",", 
   RowBox[{"ColorFunction", "\[Rule]", 
    RowBox[{"Function", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "y", ",", "z", ",", "f"}], "}"}], ",", 
      RowBox[{
       RowBox[{"ColorData", "[", "\"\<Rainbow\>\"", "]"}], "[", 
       RowBox[{"f", "/", 
        RowBox[{"Max", "[", "data", "]"}]}], "]"}]}], "]"}]}], ",", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], ",", 
   RowBox[{"RegionFunction", "\[Rule]", 
    RowBox[{"Function", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "y", ",", "z"}], "}"}], ",", 
      RowBox[{
       RowBox[{"x", "<", "z"}], "||", 
       RowBox[{"z", ">", "y"}]}]}], "]"}]}]}], "]"}]], "Input",
